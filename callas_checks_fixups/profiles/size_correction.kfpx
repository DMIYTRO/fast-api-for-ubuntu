				<qfcfgs>
					<qfcfg>
						<qffeat>javascript</qffeat>
						<qfinstructions>
							<qfinstruction>
								<qfparams>
									<qfparam key="javascript">(function () {&#10;    var config = JSON.parse(app.vars.box_config);&#10;    var fix = config.quickfixes[0];&#10;    var insetPt = 2 * 72 / 25.4;&#10;&#10;    fix.instructions = fix.instructions&#10;        .filter(function (box) { return box.which_box === &quot;BleedBox&quot;; })&#10;        .map(function (box) {&#10;            return Object.assign({}, box, {&#10;                which_box: &quot;TrimBox&quot;,&#10;                left: box.left + insetPt,&#10;                bottom: box.bottom + insetPt,&#10;                right: box.right - insetPt,&#10;                top: box.top - insetPt&#10;            });&#10;        });&#10;    return config;&#10;})();</qfparam>
								</qfparams>
							</qfinstruction>
						</qfinstructions>
					</qfcfg>
				</qfcfgs>
			</quickfix>
