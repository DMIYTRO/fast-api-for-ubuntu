				<varqcscript>({&#10;    app_vars_sub_path: &quot;QC_Input&quot;,&#10;    quickcheck_config: [&#10;        &quot;$.direct: false&quot;,&#10;        &quot;$.aggregated: false&quot;,&#10;        &quot;$.aggregated.file.name: true&quot;,&#10;        &quot;$.aggregated.pages.page.geometry: true&quot;&#10;    ]&#10;});</varqcscript>
