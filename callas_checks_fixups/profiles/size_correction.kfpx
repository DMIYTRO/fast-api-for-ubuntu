				<varkey>V_Extract_Size</varkey>
				<varscript>(function () {&#10;    var v = app.vars;&#10;    var qc = typeof v.QC_Input === &quot;string&quot; ? JSON.parse(v.QC_Input) : v.QC_Input;&#10;    var file = qc &amp;&amp; qc.aggregated &amp;&amp; qc.aggregated.file;&#10;    var name = file &amp;&amp; typeof file.name === &quot;string&quot; ? file.name : &quot;&quot;;&#10;    var pattern = /\(\s*(\d+(?:[.,]\d+)?)\s*[xX\u0445\u0425\u00D7]\s*(\d+(?:[.,]\d+)?)\s*\)/g;&#10;    var match = pattern.exec(name);&#10;&#10;    v.size_valid = 0;&#10;    v.size_error = &quot;&quot;;&#10;    v.trim_w_mm = v.trim_h_mm = v.bleed_w_mm = v.bleed_h_mm = 0;&#10;    if (!match || pattern.exec(name)) {&#10;        v.size_error = &quot;Expected exactly one (width x height) pair: &quot; + name;&#10;        return 0;&#10;    }&#10;    var w = Number(match[1].replace(&quot;,&quot;, &quot;.&quot;));&#10;    var h = Number(match[2].replace(&quot;,&quot;, &quot;.&quot;));&#10;    if (!isFinite(w) || !isFinite(h) || w &lt;= 0 || h &lt;= 0) {&#10;        v.size_error = &quot;Invalid dimensions: &quot; + name;&#10;        return 0;&#10;    }&#10;    v.trim_w_mm = w;&#10;    v.trim_h_mm = h;&#10;    v.bleed_w_mm = w + 4;&#10;    v.bleed_h_mm = h + 4;&#10;    v.size_valid = 1;&#10;    return 1;&#10;})();</varscript>
