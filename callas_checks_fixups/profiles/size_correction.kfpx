				<name></name>
				<comment></comment>
				<flags edit="1" visible="1"></flags>
				<creation>D:20261110013303+02&apos;00&apos;</creation>
				<modification>D:20261110025350+02&apos;00&apos;</modification>
				<varkey>V_Check_Outer</varkey>
				<varscript>(function () {&#10;    var v = app.vars;&#10;    var currentPages = app.doc &amp;&amp; app.doc.pages;&#10;    var source;&#10;    var rows;&#10;&#10;    v.box_config = &quot;{}&quot;;&#10;    v.size_error = &quot;&quot;;&#10;&#10;    if (typeof v.QC_Input === &quot;string&quot;) {&#10;        try {&#10;            source = JSON.parse(v.QC_Input);&#10;        } catch (e) {&#10;            v.size_error = &quot;QC_Input is not valid JSON: &quot; + e.message;&#10;            return 0;&#10;        }&#10;    } else {&#10;        source = v.QC_Input;&#10;    }&#10;&#10;    if (typeof v.geometry_report !== &quot;string&quot; || v.geometry_report.length === 0) {&#10;        v.size_error = &quot;geometry_report is missing or empty&quot;;&#10;        return 0;&#10;    }&#10;&#10;    try {&#10;        rows = JSON.parse(v.geometry_report);&#10;    } catch (e) {&#10;        v.size_error = &quot;geometry_report is not valid JSON: &quot; + e.message;&#10;        return 0;&#10;    }&#10;&#10;    var sourcePages = source &amp;&amp; source.aggregated &amp;&amp; source.aggregated.pages &amp;&amp; source.aggregated.pages.page;&#10;    var pages = currentPages &amp;&amp; {page: currentPages};&#10;    var instructions = [];&#10;    var mmPerPt = 25.4 / 72;&#10;    var eps = 0.2;&#10;&#10;    function addBox(page, type, left, bottom, right, top) {&#10;        instructions.push({&#10;            page_selector: String(page),&#10;            which_box: type,&#10;            from_box_or_absolute: &quot;absolute&quot;,&#10;            left: left, bottom: bottom, right: right, top: top,&#10;            unit: &quot;pt&quot;,&#10;            when: &quot;always&quot;&#10;        });&#10;    }&#10;&#10;    if (Boolean(pages) === false || Boolean(pages.page) === false ||&#10;        Array.isArray(rows) === false || rows.length === 0 ||&#10;        pages.page.length !== rows.length || Boolean(sourcePages) === false ||&#10;        sourcePages.length !== rows.length) {&#10;        v.size_error = &quot;Page geometry missing or page count changed&quot;;&#10;        return 0;&#10;    }&#10;&#10;    for (var i = 0; i &lt; rows.length; i++) {&#10;        var g = sourcePages[i].geometry || {};&#10;        var m = pages.page[i].mediaBox;&#10;        if (m) {&#10;            m = {left: m.left, right: m.right, bottom: m.bottom, top: m.top,&#10;                width_eff: m.right - m.left, height_eff: m.top - m.bottom};&#10;        }&#10;        var turned = Math.abs(g.Rotate || 0) % 180 === 90;&#10;        var targetW = Number(turned ? v.bleed_h_mm : v.bleed_w_mm);&#10;        var targetH = Number(turned ? v.bleed_w_mm : v.bleed_h_mm);&#10;        if (Boolean(m) === false || (m.width_eff &gt; 0) === false ||&#10;            (m.height_eff &gt; 0) === false ||&#10;            (g.UserUnit != null &amp;&amp; Number(g.UserUnit) !== 1) ||&#10;            Math.abs(m.width_eff * mmPerPt - targetW) &gt; eps ||&#10;            Math.abs(m.height_eff * mmPerPt - targetH) &gt; eps) {&#10;            v.size_error = &quot;Unexpected MediaBox on page &quot; + (i + 1);&#10;            return 0;&#10;        }&#10;        var page = i + 1;&#10;        var useSource = rows[i].operation === &quot;fields&quot;;&#10;        var w = useSource ? rows[i].original_width_pt : (targetW - 4) / mmPerPt;&#10;        var h = useSource ? rows[i].original_height_pt : (targetH - 4) / mmPerPt;&#10;        var cx = (m.left + m.right) / 2;&#10;        var cy = (m.bottom + m.top) / 2;&#10;        addBox(page, &quot;CropBox&quot;, m.left, m.bottom, m.right, m.top);&#10;        addBox(page, &quot;BleedBox&quot;, m.left, m.bottom, m.right, m.top);&#10;        addBox(page, &quot;TrimBox&quot;, cx - w / 2, cy - h / 2, cx + w / 2, cy + h / 2);&#10;    }&#10;    v.box_config = JSON.stringify({&#10;        quickfixes: [{quickfix: &quot;set_page_box&quot;, version: &quot;1.0&quot;, instructions: instructions}]&#10;    });&#10;    v.size_error = &quot;&quot;;&#10;    return v.pad_pages ? 1 : 0;&#10;})();&#10;</varscript>
