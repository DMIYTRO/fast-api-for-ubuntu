			<variable>
				<id1>V5359facecb30be3a52dbcb90908cc32c</id1>
				<id2>V94ae7cd6a5163997ffcb2c890e4bf49c</id2>
				<id3>9cb1df0803a38edc7638d07c9890d9ef</id3>
				<id4>ac9b3be0061bbe8e2c70a073daad0deb</id4>
				<id5>V87aec5e70b52a564d4e0a8308b277337</id5>
				<name></name>
				<comment></comment>
				<flags edit="1" visible="1"></flags>
				<creation>D:20261109204449+02&apos;00&apos;</creation>
				<modification>D:20261110012023+02&apos;00&apos;</modification>
				<varkey>V_Compare_Geometry</varkey>
				<varscript>(function () {&#10;    var v = app.vars;&#10;    var qc = typeof v.QC_Input === &quot;string&quot; ? JSON.parse(v.QC_Input) : v.QC_Input;&#10;    var pages = qc &amp;&amp; qc.aggregated &amp;&amp; qc.aggregated.pages;&#10;    var rows = [];&#10;    var padPages = [];&#10;    var scale = [];&#10;    var scaleBase = [];&#10;    var outputBoxes = [];&#10;    var enlarge = [];&#10;    var mmPerPt = 25.4 / 72;&#10;    var eps = 0.2;&#10;    var targetW = Number(v.bleed_w_mm);&#10;    var targetH = Number(v.bleed_h_mm);&#10;&#10;    v.geometry_report = &quot;[]&quot;;&#10;    v.pad_pages = &quot;&quot;;&#10;    v.resize_config = &quot;{}&quot;;&#10;    v.needs_resize = 0;&#10;    if (Number(v.size_valid) !== 1 || !pages || !pages.page || !pages.page.length) {&#10;        v.size_error = &quot;Missing target dimensions or page geometry&quot;;&#10;        return 0;&#10;    }&#10;&#10;    function sign(value) {&#10;        return value &gt; eps ? 1 : value &lt; -eps ? -1 : 0;&#10;    }&#10;&#10;    function addEdges(page, edges, distance) {&#10;        if (distance &gt; 0) {&#10;            enlarge.push({&#10;                page_selector: String(page),&#10;                which_edges: edges,&#10;                enlarge_by: distance,&#10;                unit: &quot;mm&quot;&#10;            });&#10;        }&#10;    }&#10;&#10;    for (var i = 0; i &lt; pages.page.length; i++) {&#10;        var g = pages.page[i].geometry || {};&#10;        var media = g.MediaBox;&#10;        var crop = g.CropBox;&#10;        var unit = g.UserUnit == null ? 1 : Number(g.UserUnit);&#10;        var rotate = g.Rotate == null ? 0 : Number(g.Rotate);&#10;        var turned = Math.abs(rotate) % 180 === 90;&#10;        var page = i + 1;&#10;        if (!media || !(media.width_eff &gt; 0) || !(media.height_eff &gt; 0) ||&#10;            !isFinite(media.width_eff) || !isFinite(media.height_eff) ||&#10;            unit !== 1 || !isFinite(rotate) || rotate % 90 !== 0) {&#10;            v.size_error = &quot;Unsupported or invalid page geometry: page &quot; + page;&#10;            return 0;&#10;        }&#10;        if (crop &amp;&amp; crop.present &amp;&amp; [&quot;left&quot;, &quot;bottom&quot;, &quot;right&quot;, &quot;top&quot;].some(function (edge) {&#10;            return Math.abs(crop[edge] - media[edge]) * mmPerPt &gt; eps;&#10;        })) {&#10;            v.size_error = &quot;CropBox differs from MediaBox: page &quot; + page;&#10;            return 0;&#10;        }&#10;&#10;        var w = (turned ? media.height_eff : media.width_eff) * mmPerPt;&#10;        var h = (turned ? media.width_eff : media.height_eff) * mmPerPt;&#10;        var dw = targetW - w;&#10;        var dh = targetH - h;&#10;        var x = sign(dw);&#10;        var y = sign(dh);&#10;        var operation = &quot;keep&quot;;&#10;        if (x * y &lt; 0 || x &lt; 0 || y &lt; 0) {&#10;            var mixed = x * y &lt; 0;&#10;            if (sign(targetW - targetH) !== 0 &amp;&amp; sign(w - h) !== sign(targetW - targetH)) {&#10;                v.size_error = &quot;Orientation requires review: page &quot; + page;&#10;                return 0;&#10;            }&#10;            operation = mixed ? &quot;stretch&quot; : &quot;scale&quot;;&#10;            scaleBase.push({&#10;                page_selector: String(page),&#10;                which_box: &quot;TrimBox&quot;,&#10;                from_box_or_absolute: &quot;absolute&quot;,&#10;                left: media.left, bottom: media.bottom, right: media.right, top: media.top,&#10;                unit: &quot;pt&quot;, when: &quot;always&quot;&#10;            });&#10;            outputBoxes.push({&#10;                page_selector: String(page),&#10;                which_box: &quot;TrimBox&quot;,&#10;                from_box_or_origin: &quot;CropBox&quot;,&#10;                relative_to: &quot;center&quot;,&#10;                hor_offset: 0, vert_offset: 0,&#10;                width: Number(turned ? v.trim_h_mm : v.trim_w_mm),&#10;                height: Number(turned ? v.trim_w_mm : v.trim_h_mm),&#10;                width_is_relative: false, height_is_relative: false,&#10;                unit: &quot;mm&quot;, when: &quot;always&quot;&#10;            });&#10;            outputBoxes.push(Object.assign({}, outputBoxes[outputBoxes.length - 1], {&#10;                which_box: &quot;BleedBox&quot;,&#10;                width: turned ? targetH : targetW,&#10;                height: turned ? targetW : targetH&#10;            }));&#10;            scale.push({&#10;                page_selector: String(page),&#10;                short_edge: Math.min(targetW, targetH),&#10;                long_edge: Math.max(targetW, targetH),&#10;                unit: &quot;mm&quot;,&#10;                page_scale_mode: mixed ? &quot;stretch_to_fill&quot; : &quot;fit_from_outside_cut_page&quot;&#10;            });&#10;        } else if (x &gt; 0 || y &gt; 0) {&#10;            operation = &quot;fields&quot;;&#10;            padPages.push(page);&#10;            addEdges(page, &quot;left_and_right&quot;, Math.max(0, turned ? dh : dw) / 2);&#10;            addEdges(page, &quot;top_and_bottom&quot;, Math.max(0, turned ? dw : dh) / 2);&#10;        }&#10;        rows.push({&#10;            page: page,&#10;            operation: operation,&#10;            original_width_pt: media.width_eff,&#10;            original_height_pt: media.height_eff,&#10;            w_mm: w,&#10;            h_mm: h&#10;        });&#10;    }&#10;&#10;    var fixes = [];&#10;    if (scale.length) {&#10;        fixes.push({quickfix: &quot;set_page_box&quot;, version: &quot;1.0&quot;, instructions: scaleBase});&#10;        fixes.push({quickfix: &quot;scale_pages&quot;, version: &quot;1.0&quot;, instructions: scale});&#10;        fixes.push({quickfix: &quot;set_page_box_by_dimensions&quot;, version: &quot;1.0&quot;, instructions: outputBoxes});&#10;    }&#10;    if (enlarge.length) fixes.push({quickfix: &quot;enlarge_pages&quot;, version: &quot;1.0&quot;, instructions: enlarge});&#10;    v.geometry_report = JSON.stringify(rows);&#10;    v.pad_pages = padPages.join(&quot;,&quot;);&#10;    v.resize_config = JSON.stringify({quickfixes: fixes});&#10;    v.needs_resize = fixes.length ? 1 : 0;&#10;    return v.needs_resize;&#10;})();</varscript>
