      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/profiles": {
   "get": {
    "summary": "List Profiles",
    "operationId": "list_profiles_profiles_get",
