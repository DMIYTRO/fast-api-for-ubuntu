 },
 "components": {
  "schemas": {
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "InputFile": {
    "properties": {
     "path": {
      "type": "string",
      "title": "Path"
     },
     "sha256": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Sha256"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "path"
    ],
    "title": "InputFile"
   },
   "MergeSpec": {
    "properties": {
     "type": {
      "type": "string",
      "const": "merge",
      "title": "Type"
     },
     "inputs": {
      "items": {
       "$ref": "#/components/schemas/InputFile"
      },
      "type": "array",
      "maxItems": 5000,
      "minItems": 1,
      "title": "Inputs"
     },
     "output": {
      "type": "string",
      "title": "Output"
     },
     "optimize": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Optimize"
     },
     "skip_corrupt": {
      "type": "boolean",
      "title": "Skip Corrupt",
      "default": false
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "type",
     "inputs",
     "output"
    ],
    "title": "MergeSpec"
   },
   "ProcessSpec": {
    "properties": {
     "type": {
      "type": "string",
      "const": "process",
      "title": "Type"
     },
     "input": {
      "$ref": "#/components/schemas/InputFile"
     },
     "profile": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1,
      "title": "Profile"
     },
     "mode": {
      "type": "string",
      "enum": [
       "fix",
       "analyze"
      ],
      "title": "Mode"
     },
     "report": {
      "items": {
       "type": "string",
       "enum": [
        "xml",
        "pdf"
       ]
      },
      "type": "array",
      "maxItems": 2,
      "minItems": 1,
      "title": "Report"
     },
     "out_dir": {
      "type": "string",
      "title": "Out Dir"
     },
     "variables": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object",
      "maxProperties": 50,
      "title": "Variables"
     },
     "output_name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Output Name"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "type",
     "input",
     "profile",
     "mode",
     "out_dir"
    ],
    "title": "ProcessSpec",
    "description": "Запуск профиля pdfToolbox: проверка (analyze) или проверка с исправлением (fix)."
   },
   "RenderSpec": {
    "properties": {
     "type": {
      "type": "string",
      "const": "render",
      "title": "Type"
     },
     "input": {
      "$ref": "#/components/schemas/InputFile"
     },
     "out_dir": {
      "type": "string",
      "title": "Out Dir"
     },
     "dpi": {
      "type": "integer",
      "maximum": 1200.0,
      "minimum": 36.0,
      "title": "Dpi",
      "default": 150
     },
     "format": {
      "type": "string",
      "enum": [
       "png",
       "webp"
      ],
      "title": "Format",
      "default": "png"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "type",
     "input",
     "out_dir"
    ],
    "title": "RenderSpec"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}