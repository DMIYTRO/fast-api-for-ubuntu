		<variables>
			<variable>
				<id1>V01403710925060fec18c58e7a9c2dfda</id1>
				<id2>V489b31a09aab159b8333cde39f56c621</id2>
				<id3>481faafd6e2b84a570a19edabac0eb72</id3>
				<id4>1f805d81ecbbc38b371018949996055b</id4>
				<id5>V3dcbdd58a9879c132cedf9059567daea</id5>
				<name>List of image resolutions</name>
				<comment></comment>
				<flags edit="1" visible="1"></flags>
				<creation>D:20190902155140+02&apos;00&apos;</creation>
				<modification>D:20190903152630+02&apos;00&apos;</modification>
				<varkey>BuildArrayWithImageResolutions</varkey>
				<varscript>// Create variable array from check results&#10;&#10;app.vars.hitarray = app.doc.result.checks[0].hits;&#10;// app.vars.imgnumber = 0;&#10;&#10;// For Debug:&#10;// console.log( JSON.stringify(app.vars.hitarray) )&#10;&#10;JSON.stringify(app.vars.hitarray);</varscript>
				<varlistvalues varval_type="0" varval_flags="0">
				</varlistvalues>
			</variable>
			<variable>
				<id1>Vb5d6945dc354eac57bef237024fb6695</id1>
				<id2>V67fa29786ebcd05ab7d6a4523a520779</id2>
				<id3>4b019af384eb1860762cb37df1d50a42</id3>
				<id4>dfe17727cb623006364a8415332ac72d</id4>
				<id5>V2cfeaf86073b83dcf34b39cdc9964b9b</id5>
				<name>Is Hit Array Empty?</name>
				<comment></comment>
				<flags edit="1" visible="1"></flags>
				<creation>D:20190902155140+02&apos;00&apos;</creation>
				<modification>D:20190902160551+02&apos;00&apos;</modification>
				<varkey>ExitIfAllHitsProcessed</varkey>
				<varscript>// Check whether the array with the results is empty.&#10;// Each entry is removed from the array when it is processed, so if the array is empty we should finish processing.&#10;// So, in that case the result of this variable should be 0, which is the same as an &quot;On Failure&quot; result, &#10;// so that the Process Plan sequence is exited&#10;// For Debug:&#10;// app.vars.hitarray = app.doc.result.checks[0].hits;&#10;&#10;if ( app.vars.hitarray.length &gt; 0 )&#10;&#9;1;&#10;else&#10;&#9;0;</varscript>
				<varlistvalues varval_type="0" varval_flags="0">
				</varlistvalues>
			</variable>
			<variable>
				<id1>Vd3d460c5d0c40f88f95650d6f8a051d9</id1>
				<id2>V323482965a1375a72c08263c70786e94</id2>
				<id3>74330107fce1afcd2806e20845e76163</id3>
				<id4>ecf164d5b88f14ed697799283e4d7d72</id4>
				<id5>V323482965a1375a72c08263c70786e94</id5>
				<name>Calculate Page Number</name>
				<comment></comment>
				<flags edit="1" visible="1"></flags>
				<creation>D:20190902155140+02&apos;00&apos;</creation>
				<modification>D:20190902155140+02&apos;00&apos;</modification>
				<varkey>calculatepagenumber</varkey>
				<varscript>// Set the page number to the page in the current hit, which is the number in the temparray.&#10;// Add 1 because the page number in the temparray are zero based, while this check is 1 based.&#10;// &#10;// For Debug:&#10;// app.vars.hitarray = app.doc.result.checks[0].hits;&#10;// loc_hitarray = app.vars.hitarray;&#10;// app.vars.temparray = loc_hitarray.splice(1,1);&#10;&#10;app.vars.temparray[0].page+1;</varscript>
				<varlistvalues varval_type="0" varval_flags="0">
				</varlistvalues>
			</variable>
			<variable>
				<id1>V2885bad85540552907bd58648a96f54e</id1>
				<id2>V1eab8e4b54888700b133058a2ab0c723</id2>
				<id3>b46312189c5645be9357356204af06d3</id3>
				<id4>b39d3db059648b770019e4f918df7ca3</id4>
				<id5>Va5d74e9a21298eec716c7a92252587ac</id5>
				<name>Make Output</name>
				<comment></comment>
				<flags edit="1" visible="1"></flags>
				<creation>D:20190902161140+02&apos;00&apos;</creation>
				<modification>D:20190903122206+02&apos;00&apos;</modification>
				<varkey>imageresolution</varkey>
				<varscript>// Take the resolution from the global temparray object and put it on the current image.&#10;// The current page is defined via the Apply To entry that uses the filter &quot;Sequential page number&quot; where the&#10;// page number is as well taken from the temparray.&#10;&#10;// For Debug:&#10;// app.vars.hitarray = app.doc.result.checks[0].hits;&#10;// loc_hitarray = app.vars.hitarray;&#10;// app.vars.temparray = loc_hitarray;&#10;&#10;Math.round(app.vars.temparray[0].triggers[1].value).toString() + &quot;ppi&quot;;&#10;&#10;</varscript>
				<varlistvalues varval_type="0" varval_flags="0">
				</varlistvalues>
			</variable>
			<variable>
				<id1>Va2d8c947a5c6c389d9c1ad1806c97181</id1>
				<id2>V1bcd7e4423090a9bea3b529d49d5ba39</id2>
				<id3>9f6313144faba22460c405cfa31df803</id3>
				<id4>0c92459b235263629e4aa30d8b1bdda6</id4>
				<id5>V0d8ad8eaa050c82e0bf8f4dd6ef3c939</id5>
				<name>Horizontal offset:</name>
				<comment></comment>
				<flags edit="1" visible="1"></flags>
				<creation>D:20190902161533+02&apos;00&apos;</creation>
				<modification>D:20190902164713+02&apos;00&apos;</modification>
				<varkey>horizontal_offset</varkey>
				<varscript>app.vars.temparray[0].llx + ( ( ( app.vars.temparray[0].urx - app.vars.temparray[0].llx ) / 2 ) - 32 )</varscript>
				<varlistvalues varval_type="0" varval_flags="0">
				</varlistvalues>
			</variable>
			<variable>
				<id1>Ve8c1470f6d11b21bcbf6e9457c9cf85d</id1>
				<id2>Vc05667257fb9c3292ce9257756abce00</id2>
				<id3>e98f9d094d9fc24d479c2dea5d63de85</id3>
				<id4>8dcd5231be5774ca2dcf0dbd1f6fa347</id4>
				<id5>V2266bfd39457ae17fd3e07211bb58b2f</id5>
				<name>Vertical offset:</name>
				<comment></comment>
				<flags edit="1" visible="1"></flags>
				<creation>D:20190902161747+02&apos;00&apos;</creation>
				<modification>D:20190902165129+02&apos;00&apos;</modification>
				<varkey>vertical_offset</varkey>
				<varscript>app.vars.temparray[0].lly + ( ( ( app.vars.temparray[0].ury - app.vars.temparray[0].lly ) / 2 ) -12 )</varscript>
				<varlistvalues varval_type="0" varval_flags="0">
				</varlistvalues>
			</variable>
			<variable>
