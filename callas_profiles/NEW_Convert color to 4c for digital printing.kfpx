							<fparam>UseFromDoc</fparam>
						</fparams>
					</fcfg>
					<fcfg>
						<ffeat>CCSettings</ffeat>
						<fparams>
							<fparam>All</fparam>
							<fparam>CalRGB</fparam>
							<fparam>ConvertToDest</fparam>
							<fparam>UseFromDoc</fparam>
						</fparams>
					</fcfg>
					<fcfg>
						<ffeat>CCSettings</ffeat>
						<fparams>
