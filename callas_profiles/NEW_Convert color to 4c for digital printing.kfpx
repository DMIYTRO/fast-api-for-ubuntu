				<name>NEW_Convert color to 4c for digital printing (Copy 1)</name>
				<comment>Converts RGB and Lab to CMYK using PSO Coated v3. Skips spot colors and grayscale. Does not embed a destination ICC profile.</comment>
				<flags user_units="1" scope="16" edit="1" visible="1"></flags>
				<creation>D:20261113115338+02&apos;00&apos;</creation>
				<modification>D:20261113115722+02&apos;00&apos;</modification>
				<fcfgs>
					<fcfg>
						<ffeat>CCDestination</ffeat>
						<fparams>
							<fparam>PSO Coated v3</fparam>
							<fparam>0</fparam>
							<fparam>EmbdNone</fparam>
							<fparam>sRGB IEC61966-2.1</fparam>
							<fparam>PSO Coated v3</fparam>
							<fparam>Dot Gain 15%</fparam>
							<fparam>1</fparam>
							<fparam>1</fparam>
							<fparam>1</fparam>
							<fparam></fparam>
							<fparam>0</fparam>
						</fparams>
					</fcfg>
					<fcfg>
						<ffeat>CCSettings</ffeat>
						<fparams>
							<fparam>All</fparam>
							<fparam>UncCMYK</fparam>
							<fparam>None</fparam>
							<fparam>UseFromDoc</fparam>
						</fparams>
					</fcfg>
					<fcfg>
						<ffeat>CCSettings</ffeat>
						<fparams>
							<fparam>All</fparam>
							<fparam>CalCMYK</fparam>
							<fparam>Decalibrate</fparam>
							<fparam>UseFromDoc</fparam>
						</fparams>
					</fcfg>
					<fcfg>
						<ffeat>CCSettings</ffeat>
						<fparams>
							<fparam>All</fparam>
							<fparam>UnCGray</fparam>
							<fparam>None</fparam>
							<fparam>UseFromDoc</fparam>
						</fparams>
					</fcfg>
					<fcfg>
						<ffeat>CCSettings</ffeat>
						<fparams>
							<fparam>All</fparam>
